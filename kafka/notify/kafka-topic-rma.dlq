apiVersion: kafka.strimzi.io/v1beta2
kind: KafkaTopic
metadata:
  name: notify.rma.dlq
  namespace: streaming
  labels:
    strimzi.io/cluster: doa-kafka
spec:
  partitions: 3
  replicas: 3
  config:
    cleanup.policy: "delete"
    retention.ms: 2592000000       # 30 days
    min.insync.replicas: 2

